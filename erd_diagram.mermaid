erDiagram
    %% ===== USER & AUTH =====
    USER {
        string id PK
        string email
        string name
        string password_hash
        string role
        boolean is_active
        datetime created_at
        datetime updated_at
    }

    ROLE {
        string id PK
        string code
        string name
    }

    USER_ROLE {
        string id PK
        string user_id FK
        string role_id FK
    }

    %% ===== ACADEMIC STRUCTURE =====
    SEMESTER {
        string id PK
        string name
        string code
        datetime start_date
        datetime end_date
        boolean is_active
    }

    SUBJECT {
        string id PK
        string code
        string name
        string description
        string semester_id FK
    }

    CLASS {
        string id PK
        string code
        string name
        string subject_id FK
        string instructor_id FK
        int capacity
        datetime created_at
    }

    %% ===== ENROLLMENT =====
    STUDENT_CLASS {
        string id PK
        string class_id FK
        string student_id FK
        string enrollment_status
        datetime enrolled_at
    }

    INSTRUCTOR_CLASS {
        string id PK
        string class_id FK
        string instructor_id FK
        datetime assigned_at
    }

    %% ===== EXAM & ASSIGNMENT =====
    EXAM {
        string id PK
        string title
        string description
        string class_id FK
        string creator_id FK
        datetime start_time
        datetime end_time
        string status
        datetime created_at
    }

    ASSIGNMENT {
        string id PK
        string title
        string description
        string class_id FK
        string creator_id FK
        datetime deadline
        string status
        datetime created_at
    }

    EXAM_SECTION {
        string id PK
        string exam_id FK
        string title
        int order
        int duration_minutes
    }

    %% ===== SUBMISSION & GRADING =====
    SUBMISSION {
        string id PK
        string exam_id FK
        string assignment_id FK
        string student_id FK
        string file_url
        datetime submitted_at
        string status
        datetime created_at
    }

    GRADING_PROFILE {
        string id PK
        string exam_id FK
        string assignment_id FK
        string title
        decimal total_points
    }

    GRADING_SESSION {
        string id PK
        string submission_id FK
        string grader_id FK
        string status
        datetime started_at
        datetime completed_at
    }

    GRADE {
        string id PK
        string submission_id FK
        string student_id FK
        decimal score
        string feedback
        string grader_id FK
        datetime graded_at
    }

    RUBRIC_CRITERION {
        string id PK
        string grading_profile_id FK
        string description
        decimal max_points
    }

    %% ===== AI & FEEDBACK =====
    AI_FEEDBACK {
        string id PK
        string submission_id FK
        string content
        string strengths
        string improvements
        datetime generated_at
    }

    LEARNING_PATH {
        string id PK
        string feedback_id FK
        string student_id FK
        string recommendations
        datetime created_at
    }

    %% ===== APPEAL & NOTIFICATION =====
    APPEAL {
        string id PK
        string submission_id FK
        string student_id FK
        string message
        string status
        datetime submitted_at
    }

    NOTIFICATION {
        string id PK
        string recipient_id FK
        string type
        string message
        boolean is_read
        datetime created_at
    }

    AUDIT_LOG {
        string id PK
        string user_id FK
        string action
        string entity_type
        string entity_id
        datetime timestamp
    }

    %% ===== RELATIONSHIPS =====
    USER ||--o{ USER_ROLE : "has"
    ROLE ||--o{ USER_ROLE : "assigned"

    SEMESTER ||--o{ SUBJECT : "contains"
    SEMESTER ||--o{ CLASS : "has"

    SUBJECT ||--o{ CLASS : "offered_in"
    SUBJECT ||--o{ EXAM : "includes"
    SUBJECT ||--o{ ASSIGNMENT : "includes"

    CLASS ||--o{ STUDENT_CLASS : "enrolls"
    CLASS ||--o{ INSTRUCTOR_CLASS : "assigns"
    CLASS ||--o{ EXAM : "has"
    CLASS ||--o{ ASSIGNMENT : "has"
    CLASS ||--o{ SUBMISSION : "receives"

    USER ||--o{ STUDENT_CLASS : "participates"
    USER ||--o{ INSTRUCTOR_CLASS : "teaches"
    USER ||--o{ EXAM : "creates"
    USER ||--o{ ASSIGNMENT : "creates"
    USER ||--o{ SUBMISSION : "submits"
    USER ||--o{ GRADE : "receives"
    USER ||--o{ GRADING_SESSION : "initiates"
    USER ||--o{ AUDIT_LOG : "creates"

    EXAM ||--o{ EXAM_SECTION : "contains"
    EXAM ||--o{ SUBMISSION : "receives"
    EXAM ||--o{ GRADING_PROFILE : "uses"
    EXAM ||--o{ AI_FEEDBACK : "generates"

    ASSIGNMENT ||--o{ SUBMISSION : "receives"
    ASSIGNMENT ||--o{ GRADING_PROFILE : "uses"
    ASSIGNMENT ||--o{ AI_FEEDBACK : "generates"

    SUBMISSION ||--o{ GRADING_SESSION : "initiates"
    SUBMISSION ||--o{ GRADE : "produces"
    SUBMISSION ||--o{ APPEAL : "receives"
    SUBMISSION ||--o{ AI_FEEDBACK : "receives"

    GRADING_PROFILE ||--o{ RUBRIC_CRITERION : "has"
    GRADING_SESSION ||--o{ GRADE : "produces"

    AI_FEEDBACK ||--o{ LEARNING_PATH : "suggests"

    APPEAL ||--o{ SUBMISSION : "contests"

    USER ||--o{ NOTIFICATION : "receives"
    USER ||--o{ LEARNING_PATH : "follows"

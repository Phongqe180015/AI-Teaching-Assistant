# Environment variables for AITA Backend

# Connection string for SQL Server (Update this with your actual database credentials)
# Format: sqlserver://[server]:[port];database=[database];user=[user];password=[password];encrypt=true
DATABASE_URL="sqlserver://localhost;database=AITA_DB;user=sa;password=your_password_here;encrypt=true;trustServerCertificate=true"

# Secret key for signing JWT tokens (Must be at least 16 characters)
JWT_SECRET="aita_super_secret_key_for_development_2026!"

# Optional Server Config (Zod defaults are used if missing)
# PORT=3000
# NODE_ENV="development"

# ==============================================================================
# GRADING ENGINE & AI CONFIGURATION
# ==============================================================================

# Gemini AI API Keys (Multiple keys can be separated by commas for load balancing)
GEMINI_API_KEYS="your_gemini_key_1,your_gemini_key_2"

# GitHub Token for accessing Azure/Github Models (GPT-4o-mini)
GITHUB_TOKEN="your_github_token_here"

# Path configs for grading files
# UPLOAD_DIR="temp/uploads"
# EXTRACTION_DIR="temp/extracted"

# Tuning configs
# BUILD_TIMEOUT_MS="30000"
# MAX_SCORE="100"
